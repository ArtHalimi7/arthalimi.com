  "manifesto": {
    "tag": "Why we exist",
    "text": "Most growing teams run on spreadsheets, chat threads and one person's memory. Work slips between people, numbers don't match, and nobody can see what's stuck. We replace all of that with one system,",
    "accent": "built around how your team really works."
  },
  "services": {
    "tag": "What we build",
    "title": "Four kinds of systems.",
    "eg": "For example",
    "items": [
      {
        "title": "Workflow systems",
        "desc": "Your process as software: steps, roles, handoffs, approvals and notifications.",
        "eg": "Production pipelines, approval flows, operations boards."
      },
      {
        "title": "Dashboards & reporting",
        "desc": "Numbers your team can trust, reconciled with the source and refreshed automatically.",
        "eg": "Revenue reporting, client reports, payroll from real work data."
      },
      {
        "title": "Integrations",
        "desc": "The tools you already use, connected so data moves without copy-paste.",
        "eg": "Meta, YouTube, Google Sheets and Drive, Slack, booking and payment systems."
      },
      {
        "title": "AI automation",
        "desc": "Language models put to work on scoring, drafting, triage and planning, with a person checking what matters.",
        "eg": "Lead scoring, content planning, document triage."
      }
