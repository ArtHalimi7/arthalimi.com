  "process": {
    "tag": "How we work",
    "title": "Four steps. No surprises.",
    "steps": [
      {
        "title": "Map",
        "desc": "We sit with the people doing the work and map the real process. You get a written scope and a fixed plan."
      },
      {
        "title": "Build",
        "desc": "Weekly releases you can click on, not status reports. Your feedback goes straight into the next version."
      },
      {
        "title": "Launch",
        "desc": "The new system runs alongside the old way until your team trusts it. Then the spreadsheets get switched off."
      },
      {
        "title": "Run",
        "desc": "Monitoring, fixes and improvements after launch. We stay on, so the system keeps up with the business."
      }
    ],
